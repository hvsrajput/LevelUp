# =============================================================================
# Level Up — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Database (Neon PostgreSQL) ---
# Use the pooled connection string for serverless environments
DATABASE_URL="postgresql://user:password@host.neon.tech/levelup?sslmode=require"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Auth.js will use this as the base URL for callbacks
AUTH_URL="http://localhost:3000"

# --- GitHub OAuth ---
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Google OAuth ---
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- OpenAI (Phase 3 — RAG) ---
# OPENAI_API_KEY=""

# --- LeetCode (Phase 7) ---
# LEETCODE_SESSION=""  # Encrypted at rest; see README for caveats
